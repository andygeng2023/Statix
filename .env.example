# Alpaca market-data credentials. Never commit real values.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Same names are accepted by the app/worker:
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# SEC requests need a real identifying User-Agent email.
SEC_USER_AGENT_EMAIL=you@example.com
# Shared production database.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
STATIX_WORKER_POLL_SECONDS=5
