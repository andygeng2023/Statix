# ============================================================
# STATIX CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

# Local development:
# database_url = "sqlite:///statix.db"

# Production:
database_url = "postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE"


# ------------------------------------------------------------
# MARKET DATA
# ------------------------------------------------------------

market_provider = "yahoo"

quote_cache_seconds = 20

history_cache_seconds = 300

prediction_horizon = 5


# ------------------------------------------------------------
# MODEL
# ------------------------------------------------------------

model_version = "statix-v9-global-1"

feature_version = "statix-v9-features-1"

minimum_training_rows = 500


# ------------------------------------------------------------
# SCANNER
# ------------------------------------------------------------

scanner_default_limit = 25

scanner_max_symbols = 10000


# ------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------

require_auth = true


# ------------------------------------------------------------
# STREAMLIT OIDC
# ------------------------------------------------------------

[auth]

redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"

cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"

client_id = "YOUR_GOOGLE_CLIENT_ID"

client_secret = "YOUR_GOOGLE_CLIENT_SECRET"

server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"