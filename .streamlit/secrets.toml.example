quantdash_api_key = "YOUR_QUANTDASH_API_KEY"
SEC_USER_AGENT_EMAIL = "your-email@example.com"
provider = "auto"
require_auth = false
database_url = "postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE"

