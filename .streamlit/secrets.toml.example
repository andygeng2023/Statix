require_auth = false
# Production: use PostgreSQL. Leave blank for local SQLite development.
database_url = "postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE"

# Provider: auto, akshare, quantdash, tushare, yfinance
provider = "auto"

# QuantDash is intentionally configurable because I could not verify a public official API contract.
# Fill these from the QuantDash service you actually use.
quantdash_base_url = ""
quantdash_api_key = ""
quantdash_quote_path = "/v1/quote"
quantdash_history_path = "/v1/history"
quantdash_search_path = "/v1/search"

tushare_token = ""

# SEC public APIs do not require an API key. Give SEC a real contact email for User-Agent identification.
SEC_USER_AGENT_EMAIL = "you@example.com"

# Optional: application identity
app_name = "Statix"
